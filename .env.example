APP_NAME=FEMOPROR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Em produção: true. A sessão fica no banco; sem isto o conteúdo dela é
# legível por quem conseguir ler a tabela.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção: true, para o cookie de sessão só trafegar em https.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Comprovantes e relatórios das UMPs vão para o disco privado
# (storage/app/private), servidos só por URL assinada.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Envio de e-mail (confirmação de inscrição)
# ---------------------------------------------------------------------------
# MAIL_MAILER=log NÃO envia nada: grava em storage/logs/laravel.log. Serve para
# desenvolver, e é o que está aqui. Em produção use smtp.
#
# Gmail (caminho mais rápido, 500 e-mails/dia):
#   1. Ative a verificação em duas etapas na conta femopror@gmail.com
#   2. Gere uma "Senha de app" em myaccount.google.com/apppasswords
#   3. MAIL_MAILER=smtp / MAIL_HOST=smtp.gmail.com / MAIL_PORT=587
#      MAIL_SCHEME=tls / MAIL_USERNAME=femopror@gmail.com
#      MAIL_PASSWORD=<a senha de app, 16 letras, sem espaços>
#
# Resend (melhor entrega, 3.000/mês grátis, exige domínio próprio):
#   MAIL_HOST=smtp.resend.com / MAIL_PORT=587 / MAIL_USERNAME=resend
#   MAIL_PASSWORD=<api key>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Sem timeout curto, um SMTP travado segura a tela de inscrição até o PHP morrer.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="femopror@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Onde ficam os arquivos enviados (comprovantes, relatórios)
# ---------------------------------------------------------------------------
# `local` = storage/app/private (desenvolvimento)
# `r2`    = Cloudflare R2 (produção)
# Trocar aqui NÃO move o que já foi enviado — veja femopror:migrar-arquivos.
UPLOADS_DISK=local

# Cloudflare R2 — dash.cloudflare.com › R2 › Create bucket
#   Nome sugerido: femopror-comprovantes. Mantenha o bucket PRIVADO
#   (sem "Public access"): o sistema serve por link assinado que expira.
#
#   Depois: R2 › API › Manage API Tokens › Create Account API Token
#     Permissão: "Object Read & Write", restrito a esse bucket.
#   O endpoint aparece na página do bucket como "S3 API":
#     https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=femopror-comprovantes
R2_ENDPOINT=

# Recebimento por PIX (ver config/femopror.php).
# A chave vai no formato do BR Code; para telefone, +5584999999999.
PIX_KEY="+5584991350289"
PIX_RECEIVER="Adson Avelino"
PIX_CITY="Mossoro"
PIX_DISPLAY_KEY="84991350289"
PIX_DISPLAY_LABEL="Celular"
PIX_DISPLAY_OWNER="Federação de Mocidades do PROR / Adson (Tesouraria)"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
